{
    "name": "@oliverperzyk/chemistry-project",
    "description": "Website about octane rating, created as a chemistry project.",
    "version": "0.0.1",
    "private": true,
    "license": "MIT",
    "homepage": "https://chemistry.oliverperzyk.com",
    "author": {
        "name": "oliverperzyk (Oliwier Perzyński)",
        "email": "olek@oliverperzyk.com",
        "url": "https://oliverperzyk.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/oliverperzyk/chemistry-project.git"
    },
    "bugs": {
        "url": "https://github.com/oliverperzyk/chemistry-project/issues"
    },
    "engines": {
        "bun": ">=1.4"
    },
    "scripts": {
        "format": "bunx --bun prettier --write .",
        "format:check": "bunx --bun prettier --check .",
        "lint": "bunx --bun eslint .",
        "lint:fix": "bunx --bun eslint --fix .",
        "typecheck": "bun --bun next typegen && bunx --bun tsc --noEmit",
        "test": "bun test",
        "test:init": "bun ./tests/TestEnvironment.ts",
        "healthcheck": "bun ./scripts/Healthcheck.ts",
        "dev:vinext": "bunx vite dev --port 3001",
        "build:vinext": "bunx vite build",
        "start:vinext": "bunx vite preview",
        "deploy:vinext": "bunx vinext-cloudflare deploy",
        "prepare": "[ \"$LEFTHOOK\" = \"0\" ] || lefthook install"
    },
    "lint-staged": {
        "**/*.{ts,tsx,css,json,json5,jsonc,md}": [
            "bunx eslint --fix",
            "bunx prettier --write"
        ],
        "**/*.{yml,yaml}": [
            "bunx prettier --write"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@vinext/cloudflare": "^1.3.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.57.0",
        "next": "16.2.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-server-dom-webpack": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "vinext": "^1.4.0"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^2.0.0-beta.v.8",
        "@eslint/css": "^2.0.0",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.1.1",
        "@eslint/markdown": "^8.0.3",
        "@next/eslint-plugin-next": "16.2.6",
        "@tailwindcss/postcss": "^4",
        "@types/bun": "^1.4.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitejs/plugin-rsc": "^0.5.38",
        "babel-plugin-react-compiler": "1.0.0",
        "cf": "^1.0.0-beta.26",
        "eslint": "^10.12.0",
        "eslint-plugin-react": "^7.37.5",
        "globals": "^17.13.0",
        "jiti": "^2.7.0",
        "lefthook": "^2.2.2",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "tailwindcss": "^4",
        "typescript": "6",
        "typescript-eslint": "^8.71.2",
        "vite": "8.3.0"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ],
    "type": "module"
}
